# Normalise line endings for text
* text=auto

# Unity YAML assets are text; merge as text
*.unity     text eol=lf
*.prefab    text eol=lf
*.asset     text eol=lf
*.meta      text eol=lf
*.mat       text eol=lf
*.anim      text eol=lf
*.controller text eol=lf
*.asmdef    text eol=lf
*.cs        text diff=csharp
*.json      text
*.md        text

# Git LFS (D-019): audio, models, large art
*.wav   filter=lfs diff=lfs merge=lfs -text
*.ogg   filter=lfs diff=lfs merge=lfs -text
*.mp3   filter=lfs diff=lfs merge=lfs -text
*.onnx  filter=lfs diff=lfs merge=lfs -text
*.bin   filter=lfs diff=lfs merge=lfs -text
*.gguf  filter=lfs diff=lfs merge=lfs -text
*.ort   filter=lfs diff=lfs merge=lfs -text
*.tflite filter=lfs diff=lfs merge=lfs -text
*.psd   filter=lfs diff=lfs merge=lfs -text
*.ttf   filter=lfs diff=lfs merge=lfs -text
*.otf   filter=lfs diff=lfs merge=lfs -text
Assets/_SpeakBack/Art/**/*.png filter=lfs diff=lfs merge=lfs -text
