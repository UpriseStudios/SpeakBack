# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# IDE / solution files (regenerated by Unity)
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash / build artefacts
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# .NET test project output (Tools/DotnetTests)
**/bin/
**/obj/
!/[Aa]ssets/**/bin/
TestResults/

# Python (Tools/BakeOff, Tools/Content)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Bake-off recordings, model caches and outputs must never be committed (CLAUDE.md, D-017)
speakback-bakeoff/
**/bakeoff_data/
**/bakeoff_out/
**/model_cache/

# Secrets
*.keystore
*.jks
.env
*.env

# OS
.DS_Store
Thumbs.db
desktop.ini
